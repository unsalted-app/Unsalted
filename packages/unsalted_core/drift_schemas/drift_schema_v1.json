        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipes\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"master_version_id\" TEXT NULL, \"owner_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
